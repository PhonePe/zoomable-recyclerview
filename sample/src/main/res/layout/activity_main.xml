<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <!-- Instructions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Pinch to zoom"
            android:textSize="12sp"
            android:textColor="#444444"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👆 Double-tap to zoom"
            android:textSize="12sp"
            android:textColor="#444444"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✋ Drag to pan"
            android:textSize="12sp"
            android:textColor="#444444"
            android:gravity="center" />

    </LinearLayout>

    <!-- ZoomableRecyclerView in a bordered card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_recycler_border"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="2dp">

        <com.phonepe.zoomablerecyclerview.ZoomableRecyclerView
            android:id="@+id/zoomableRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:zrv_minScale="1.0"
            app:zrv_maxScale="5.0"
            app:zrv_doubleTapZoomScale="2.5"
            app:zrv_zoomEnabled="true"
            app:zrv_doubleTapZoomEnabled="true"
            app:zrv_flingEnabled="true" />

    </FrameLayout>

</LinearLayout>
